From 8940ff711cf5ffc8e8e50b4f01b2925897d703db Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Thu, 5 Nov 2026 13:11:02 -0500
Subject: [PATCH] freetype: use a private pkg-config prefix for harfbuzz

OpenCV 5.1 core (opencv/opencv#29300, cmake/OpenCVFindHarfBuzz.cmake)
resolves HarfBuzz for cv::putText and stores the result, including
libharfbuzz-raster when the system splits hb-raster into its own
library, in the HARFBUZZ_LIBRARIES / HARFBUZZ_INCLUDE_DIR cache
variables that modules/imgproc links against.

This module then calls ocv_check_modules(HARFBUZZ harfbuzz), which
overwrites the same cache variables with plain harfbuzz.pc. imgproc
ends up linked without libharfbuzz-raster (undefined hb_raster_*), or,
when core built the bundled HarfBuzz, against the system library
instead of the bundled one.

Probe under FREETYPE_HARFBUZZ so the two lookups no longer collide.
---
 modules/freetype/CMakeLists.txt | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/modules/freetype/CMakeLists.txt b/modules/freetype/CMakeLists.txt
index 6dd4aaf..1139a43 100644
--- a/modules/freetype/CMakeLists.txt
+++ b/modules/freetype/CMakeLists.txt
@@ -4,7 +4,7 @@ if(APPLE_FRAMEWORK)
 endif()
 
 ocv_check_modules(FREETYPE freetype2)
-ocv_check_modules(HARFBUZZ harfbuzz)
+ocv_check_modules(FREETYPE_HARFBUZZ harfbuzz)
 
 if(OPENCV_INITIAL_PASS)
   if(NOT FREETYPE_FOUND)
@@ -13,17 +13,17 @@ if(OPENCV_INITIAL_PASS)
     message(STATUS "freetype2:   YES (ver ${FREETYPE_VERSION})")
   endif()
 
-  if(NOT HARFBUZZ_FOUND)
+  if(NOT FREETYPE_HARFBUZZ_FOUND)
     message(STATUS "harfbuzz:    NO")
   else()
-    message(STATUS "harfbuzz:    YES (ver ${HARFBUZZ_VERSION})")
+    message(STATUS "harfbuzz:    YES (ver ${FREETYPE_HARFBUZZ_VERSION})")
   endif()
 endif()
 
-if(FREETYPE_FOUND AND HARFBUZZ_FOUND)
+if(FREETYPE_FOUND AND FREETYPE_HARFBUZZ_FOUND)
   ocv_define_module(freetype opencv_core opencv_imgproc WRAP python)
-  ocv_target_link_libraries(${the_module} ${FREETYPE_LIBRARIES} ${HARFBUZZ_LIBRARIES})
-  ocv_include_directories( ${FREETYPE_INCLUDE_DIRS} ${HARFBUZZ_INCLUDE_DIRS} )
+  ocv_target_link_libraries(${the_module} ${FREETYPE_LIBRARIES} ${FREETYPE_HARFBUZZ_LIBRARIES})
+  ocv_include_directories( ${FREETYPE_INCLUDE_DIRS} ${FREETYPE_HARFBUZZ_INCLUDE_DIRS} )
 else()
   ocv_module_disable(freetype)
 endif()
-- 
