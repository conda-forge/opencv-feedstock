@@ -1527,6 +1529,7 @@ class GOVBackendImpl final: public cv::gapi::GBackend::Priv {
                               const ade::NodeHandle &nh,
                               const cv::GKernelImpl &ii) override {
         using namespace cv::gimpl;
+        cv::gapi::ov::wrap::requireRuntime();
         // FIXME: Introduce a DNNBackend interface which'd specify
         // the framework for this???
         GOVModel gm(gr);
@@ -1555,6 +1558,7 @@ class GOVBackendImpl final: public cv::gapi::GBackend::Priv {
     virtual EPtr compile(const ade::Graph &graph,
                          const cv::GCompileArgs &compileArgs,
                          const std::vector<ade::NodeHandle> &nodes) const override {
+        cv::gapi::ov::wrap::requireRuntime();
         return EPtr{new cv::gimpl::ov::GOVExecutable(graph, compileArgs, nodes)};
     }
 
diff --git a/modules/gapi/src/backends/ov/govlazy.cpp b/modules/gapi/src/backends/ov/govlazy.cpp
new file mode 100644
index 0000000..ca3ca63
--- /dev/null
+++ b/modules/gapi/src/backends/ov/govlazy.cpp
@@ -0,0 +1,99 @@
+// This file is part of OpenCV project.
+// It is subject to the license terms in the LICENSE file found in the top-level directory
+// of this distribution and at http://opencv.org/license.html.
+
+// Runtime side of OPENCV_GAPI_OPENVINO_LAZY, see cmake/openvino_lazy.cmake.
+
+#include "backends/ov/govlazy.hpp"
+
+#include <opencv2/gapi/util/throw.hpp>
+
+#include <stdexcept>
+#include <string>
+
+extern "C" const char cv_gapi_ov_lazy_libname[];
+
+static void throwMissingRuntime() {
+    cv::util::throw_error(std::runtime_error(
+        std::string("G-API: the OpenVINO backend requires the OpenVINO runtime (")
+        + cv_gapi_ov_lazy_libname + "), which could not be loaded"));
+}
+
+#if defined(_WIN32)
+
+#include <windows.h>
+
+static bool runtimeAvailable() {
+    // Same lookup as the delay-load helper; keeps the DLL loaded so the
+    // delay-load thunks resolve against it on first call.
+    static const bool available = LoadLibraryExA(cv_gapi_ov_lazy_libname, NULL, 0) != NULL;
+    return available;
+}
+
+#elif defined(__APPLE__)
+
+#include <dlfcn.h>
+
+static bool runtimeAvailable() {
+    // libopenvino is weak-linked: dyld either loaded it at startup or left
+    // all of its symbols NULL.
+    static const bool available =
+        dlopen(cv_gapi_ov_lazy_libname, RTLD_LAZY | RTLD_NOLOAD) != NULL;
+    return available;
+}
+
+#else
+
+#include <dlfcn.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cxxabi.h>
+
+extern "C" {
+extern const unsigned cv_gapi_ov_lazy_count;
+extern const char* const cv_gapi_ov_lazy_names[];
+extern void* cv_gapi_ov_lazy_table[];
+
+[[noreturn]] __attribute__((visibility("hidden"))) void cv_gapi_ov_lazy_missing() {
+    std::fprintf(stderr, "G-API: OpenVINO function called but the OpenVINO runtime (%s) "
+                         "could not be loaded\n", cv_gapi_ov_lazy_libname);
+    std::abort();
+}
+}
+
+// ov::Any::Impl<T> instantiated in G-API refer to the typeinfo of their base
+// ov::Any::Base (a private class deriving from
+// std::enable_shared_from_this<Base>), the only data symbol G-API imports from
+// libopenvino. Provide a local copy; libstdc++ compares type_info by name, so
+// it is equivalent to the one in libopenvino.
+static const abi::__class_type_info cv_gapi_ov_any_base_parent_typeinfo(
+    "St23enable_shared_from_thisIN2ov3Any4BaseEE");
+extern const abi::__si_class_type_info cv_gapi_ov_any_base_typeinfo
+    __asm__("_ZTIN2ov3Any4BaseE") __attribute__((visibility("hidden")));
+const abi::__si_class_type_info cv_gapi_ov_any_base_typeinfo(
+    "N2ov3Any4BaseE", &cv_gapi_ov_any_base_parent_typeinfo);
+
+static void* g_openvino = nullptr;
+
+__attribute__((constructor))
+static void loadOpenVINO() {
+    void* handle = dlopen(cv_gapi_ov_lazy_libname, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+        return;
+    for (unsigned i = 0; i < cv_gapi_ov_lazy_count; ++i) {
+        if (void* sym = dlsym(handle, cv_gapi_ov_lazy_names[i]))
+            cv_gapi_ov_lazy_table[i] = sym;
+    }
+    g_openvino = handle;
+}
+
+static bool runtimeAvailable() {
+    return g_openvino != nullptr;
+}
+
+#endif
+
+void cv::gapi::ov::wrap::requireRuntime() {
+    if (!runtimeAvailable())
+        throwMissingRuntime();
+}
diff --git a/modules/gapi/src/backends/ov/govlazy.hpp b/modules/gapi/src/backends/ov/govlazy.hpp
new file mode 100644
index 0000000..6f4e6f8
--- /dev/null
+++ b/modules/gapi/src/backends/ov/govlazy.hpp
@@ -0,0 +1,26 @@
+// This file is part of OpenCV project.
+// It is subject to the license terms in the LICENSE file found in the top-level directory
+// of this distribution and at http://opencv.org/license.html.
+
+#ifndef OPENCV_GAPI_GOVLAZY_HPP
+#define OPENCV_GAPI_GOVLAZY_HPP
+
+namespace cv {
+namespace gapi {
+namespace ov {
+namespace wrap {
+
+// Throws if G-API was built with OPENCV_GAPI_OPENVINO_LAZY and the
+// OpenVINO runtime could not be loaded. No-op otherwise.
+#ifdef OPENCV_GAPI_OPENVINO_LAZY
+void requireRuntime();
+#else
+inline void requireRuntime() {}
+#endif
+
+} // namespace wrap
+} // namespace ov
+} // namespace gapi
+} // namespace cv
+
+#endif // OPENCV_GAPI_GOVLAZY_HPP
-- 
