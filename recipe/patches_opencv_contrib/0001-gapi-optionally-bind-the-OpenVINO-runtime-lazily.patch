index 9957419..f02e411 100644
--- a/modules/gapi/src/backends/ov/govbackend.cpp
+++ b/modules/gapi/src/backends/ov/govbackend.cpp
@@ -13,6 +13,7 @@
 #if defined HAVE_INF_ENGINE && INF_ENGINE_RELEASE >= 2022010000
 
 #include "backends/ov/util.hpp"
+#include "backends/ov/govlazy.hpp"
 #include "api/gbackend_priv.hpp" // FIXME: Make it part of Backend SDK!
 #include "logger.hpp"
 
@@ -54,6 +55,7 @@ static ov::Core create_OV_Core_instance() {
 }
 
 ov::Core cv::gapi::ov::wrap::getCore() {
+    cv::gapi::ov::wrap::requireRuntime();
     // NB: to make happy memory leak tools use:
