From cd55da755c7ee45fb8bf932868b8d4975d938b0a Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Fri, 16 Oct 2026 22:38:57 -0400
Subject: [PATCH] gapi: optionally bind the OpenVINO runtime lazily

Add OPENCV_GAPI_OPENVINO_LAZY. When enabled, libopencv_gapi keeps the
OpenVINO inference backend but no longer requires the OpenVINO runtime
to be installed to load:

- Linux: libopencv_gapi is not linked against libopenvino. At configure
  time every ov:: function exported by libopenvino gets a hidden
  trampoline that jumps through a table; the table is filled with
  dlopen()/dlsym() when libopencv_gapi is loaded. The single data symbol
  G-API needs (typeinfo for ov::Any::Base) is provided locally.
- macOS: libopenvino is weak-linked (-weak_library).
- Windows: openvino.dll is delay-loaded (/DELAYLOAD).

The backend entry points (unpackKernel, compile, getCore) call
cv::gapi::ov::wrap::requireRuntime(), which throws a std::runtime_error
naming the missing library instead of failing at load time.
---
 modules/gapi/CMakeLists.txt                 |  10 +-
 modules/gapi/cmake/openvino_lazy.cmake      | 102 ++++++++++++++++++++
 modules/gapi/src/backends/ov/govbackend.cpp |   4 +
 modules/gapi/src/backends/ov/govlazy.cpp    |  99 +++++++++++++++++++
 modules/gapi/src/backends/ov/govlazy.hpp    |  26 +++++
 5 files changed, 239 insertions(+), 2 deletions(-)
 create mode 100644 modules/gapi/cmake/openvino_lazy.cmake
 create mode 100644 modules/gapi/src/backends/ov/govlazy.cpp
 create mode 100644 modules/gapi/src/backends/ov/govlazy.hpp

diff --git a/modules/gapi/CMakeLists.txt b/modules/gapi/CMakeLists.txt
index 98f225c..dfecbde 100644
--- a/modules/gapi/CMakeLists.txt
+++ b/modules/gapi/CMakeLists.txt
@@ -271,9 +271,15 @@ ocv_create_module()
 
 ocv_target_link_libraries(${the_module} PRIVATE ade)
 
+ocv_option(OPENCV_GAPI_OPENVINO_LAZY "G-API: load the OpenVINO runtime on first use instead of linking it" OFF)
 if(TARGET ocv.3rdparty.openvino AND OPENCV_GAPI_WITH_OPENVINO)
-  ocv_target_link_libraries(${the_module} PRIVATE ocv.3rdparty.openvino)
-  ocv_install_used_external_targets(ocv.3rdparty.openvino)
+  if(OPENCV_GAPI_OPENVINO_LAZY)
+    include("${CMAKE_CURRENT_LIST_DIR}/cmake/openvino_lazy.cmake")
+    ocv_gapi_openvino_lazy(${the_module})
+  else()
+    ocv_target_link_libraries(${the_module} PRIVATE ocv.3rdparty.openvino)
+    ocv_install_used_external_targets(ocv.3rdparty.openvino)
+  endif()
 endif()
 
 if(HAVE_TBB)
diff --git a/modules/gapi/cmake/openvino_lazy.cmake b/modules/gapi/cmake/openvino_lazy.cmake
new file mode 100644
index 0000000..1b61b5b
--- /dev/null
+++ b/modules/gapi/cmake/openvino_lazy.cmake
@@ -0,0 +1,102 @@
+# Bind the OpenVINO runtime lazily so that libopencv_gapi can be loaded
+# without it being installed (OPENCV_GAPI_OPENVINO_LAZY).
+#
+# - Linux: libopencv_gapi is not linked against libopenvino. Every function
+#   exported by libopenvino in the ov:: namespace gets a hidden trampoline
+#   that jumps through a table filled by dlopen()/dlsym() when
+#   libopencv_gapi is loaded.
+# - macOS: libopenvino is weak-linked (-weak_library).
+# - Windows: openvino.dll is delay-loaded (/DELAYLOAD).
+#
+# In all cases the OpenVINO backend entry points call
+# cv::gapi::ov::wrap::requireRuntime(), which throws if the runtime is missing.
+
+function(ocv_gapi_openvino_lazy target)
+  if(CMAKE_VERSION VERSION_LESS "3.27")
+    message(FATAL_ERROR "OPENCV_GAPI_OPENVINO_LAZY requires CMake 3.27 or newer")
+  endif()
+
+  set(_loc "")
+  set(_soname "")
+  foreach(_cfg RELEASE RELWITHDEBINFO MINSIZEREL NOCONFIG DEBUG)
+    if(NOT _loc)
+      get_target_property(_loc openvino::runtime IMPORTED_LOCATION_${_cfg})
+      get_target_property(_soname openvino::runtime IMPORTED_SONAME_${_cfg})
+    endif()
+  endforeach()
+  if(NOT _loc)
+    message(FATAL_ERROR "OPENCV_GAPI_OPENVINO_LAZY: cannot locate the openvino::runtime library")
+  endif()
+  if(_soname AND NOT WIN32)
+    set(_libname "${_soname}")
+  else()
+    get_filename_component(_libname "${_loc}" NAME)
+  endif()
+
+  set(_gen "${CMAKE_CURRENT_BINARY_DIR}/openvino_lazy_gen.cpp")
+  set(_content "// Generated by modules/gapi/cmake/openvino_lazy.cmake from ${_loc}\n")
+  string(APPEND _content "extern \"C\" const char cv_gapi_ov_lazy_libname[] = \"${_libname}\";\n")
+
+  if(WIN32)
+    ocv_target_link_libraries(${target} PRIVATE ocv.3rdparty.openvino delayimp)
+    ocv_install_used_external_targets(ocv.3rdparty.openvino)
+    target_link_options(${target} PRIVATE "/DELAYLOAD:${_libname}")
+  elseif(APPLE)
+    target_link_libraries(${target} PRIVATE "$<COMPILE_ONLY:ocv.3rdparty.openvino>")
+    target_link_options(${target} PRIVATE "LINKER:-weak_library,${_loc}")
+  else()
+    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
+      set(_arch x86_64)
+    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
+      set(_arch aarch64)
+    else()
+      message(FATAL_ERROR "OPENCV_GAPI_OPENVINO_LAZY: unsupported processor ${CMAKE_SYSTEM_PROCESSOR}")
+    endif()
+    execute_process(COMMAND "${CMAKE_NM}" -D --defined-only "${_loc}"
+                    OUTPUT_VARIABLE _nm RESULT_VARIABLE _rc)
+    if(NOT _rc EQUAL 0)
+      message(FATAL_ERROR "OPENCV_GAPI_OPENVINO_LAZY: '${CMAKE_NM} -D ${_loc}' failed")
+    endif()
+    string(REGEX MATCHALL " T _ZNK?2ov[A-Za-z0-9_]*" _syms "${_nm}")
+    list(REMOVE_DUPLICATES _syms)
+    list(LENGTH _syms _count)
+    if(_count EQUAL 0)
+      message(FATAL_ERROR "OPENCV_GAPI_OPENVINO_LAZY: no ov:: functions exported by ${_loc}")
+    endif()
+
+    set(_asm "")
+    set(_names "")
+    set(_idx 0)
+    foreach(_line ${_syms})
+      string(SUBSTRING "${_line}" 3 -1 _sym)
+      math(EXPR _off "${_idx} * 8")
+      string(APPEND _asm ".globl ${_sym}\n.hidden ${_sym}\n.type ${_sym}, @function\n.p2align 4\n${_sym}:\n")
+      if(_arch STREQUAL "x86_64")
+        string(APPEND _asm "  jmp *(cv_gapi_ov_lazy_table+${_off})(%rip)\n")
+      else()
+        string(APPEND _asm "  adrp x16, cv_gapi_ov_lazy_table+${_off}\n  ldr x16, [x16, #:lo12:cv_gapi_ov_lazy_table+${_off}]\n  br x16\n")
+      endif()
+      string(APPEND _asm ".size ${_sym}, .-${_sym}\n")
+      string(APPEND _names "  \"${_sym}\",\n")
+      math(EXPR _idx "${_idx} + 1")
+    endforeach()
+    string(REPEAT "  (void*)&cv_gapi_ov_lazy_missing,\n" ${_count} _init)
+
+    string(APPEND _content "extern \"C\" {\n")
+    string(APPEND _content "[[noreturn]] void cv_gapi_ov_lazy_missing();\n")
+    string(APPEND _content "__attribute__((visibility(\"hidden\"))) extern const unsigned cv_gapi_ov_lazy_count = ${_count};\n")
+    string(APPEND _content "__attribute__((visibility(\"hidden\"))) extern const char* const cv_gapi_ov_lazy_names[${_count}] = {\n${_names}};\n")
+    string(APPEND _content "__attribute__((visibility(\"hidden\"))) void* cv_gapi_ov_lazy_table[${_count}] = {\n${_init}};\n")
+    string(APPEND _content "}\n")
+    string(APPEND _content "__asm__(R\"CV_GAPI_OV_ASM(\n.pushsection .text\n${_asm}.popsection\n)CV_GAPI_OV_ASM\");\n")
+
+    target_link_libraries(${target} PRIVATE "$<COMPILE_ONLY:ocv.3rdparty.openvino>" ${CMAKE_DL_LIBS})
+    target_link_options(${target} PRIVATE "LINKER:--no-undefined")
+    message(STATUS "G-API: OpenVINO runtime ${_libname} is loaded lazily (${_count} trampolines)")
+  endif()
+
+  file(WRITE "${_gen}.tmp" "${_content}")
+  configure_file("${_gen}.tmp" "${_gen}" COPYONLY)
+  target_sources(${target} PRIVATE "${_gen}" "${CMAKE_CURRENT_LIST_DIR}/src/backends/ov/govlazy.cpp")
+  target_compile_definitions(${target} PRIVATE OPENCV_GAPI_OPENVINO_LAZY=1)
+endfunction()
