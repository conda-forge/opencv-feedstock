cmake_minimum_required(VERSION 3.18)
# Exercise OpenCV's architecture handling without a CUDA toolkit or GPU.
macro(find_package name)
  if(NOT "${name}" STREQUAL "CUDAToolkit")
    message(FATAL_ERROR "Unexpected package lookup: ${name}")
  endif()
  set(CUDAToolkit_FOUND TRUE)
  set(CUDAToolkit_VERSION "13.4")
  set(CUDAToolkit_NVCC_EXECUTABLE "must-not-autodetect-a-GPU")
endmacro()
macro(OCV_OPTION name help default)
  set(${name} "${default}")
endmacro()
set(WIN32 FALSE)
set(CMAKE_CUDA_COMPILER "unused")
set(BUILD_SHARED_LIBS ON)
set(expected "75-real;90a-real;100f-real;121f-real;121-virtual")
set(CMAKE_CUDA_ARCHITECTURES "${expected}")
include(cmake/OpenCVDetectCUDALanguage.cmake)
if(NOT HAVE_CUDA OR NOT CMAKE_CUDA_ARCHITECTURES STREQUAL expected OR NOT OpenCV_CUDA_CC STREQUAL expected)
  message(FATAL_ERROR "CUDA architecture suffixes were lost: ${CMAKE_CUDA_ARCHITECTURES}")
endif()
string(STRIP "${OPENCV_CUDA_ARCH_BIN}" bins)
string(STRIP "${OPENCV_CUDA_ARCH_PTX}" ptx)
if(NOT bins STREQUAL "75 90 100 121" OR NOT ptx STREQUAL "121")
  message(FATAL_ERROR "Incorrect OpenCV capability metadata: BIN=${bins}, PTX=${ptx}")
endif()
